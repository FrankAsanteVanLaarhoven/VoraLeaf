# Server-only configuration. Copy to .env locally and keep it out of Git.
# Blank values keep the corresponding provider feature unavailable.
# DB (D1) and BUCKET (R2) are platform bindings, not text environment variables.
# Never expose this server directly to untrusted identity headers; see docs/CREATOR_STUDIO.md.

# Fitness discovery
# Original tutorial provider: exercisedb.p.rapidapi.com, with an active subscription.
RAPIDAPI_KEY=
# YouTube Data API v3, for dynamic related-video search (separate from OAuth).
YOUTUBE_API_KEY=

# Verified purchaser / active paid recurring membership
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Independent high-entropy server secret, at least 32 characters.
STUDIO_MEMBERSHIP_BINDING_SECRET=
# Comma-separated qualifying Stripe Price IDs, e.g. price_exampleOne,price_exampleTwo.
VORALEAF_STRIPE_PRICE_IDS=

# YouTube account connection and recorded uploads
# Register the exact HTTPS /api/studio/oauth/youtube/callback redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A base64-encoded random 32-byte AES key. Also protects live publishing credentials.
STUDIO_TOKEN_ENCRYPTION_KEY=

# Member-only Cloudflare Stream WHIP/WHEP broadcasting
CLOUDFLARE_ACCOUNT_ID=
STREAM_API_TOKEN=
STREAM_SIGNING_KEY_ID=
# Private RSA JWK JSON, or base64-encoded JWK JSON, from your Stream signing-key setup.
STREAM_SIGNING_KEY_JWK=
